# ============================================================
#  OutfitAR - Environment Variables
#  Copy file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# --- Aplikasi ---
APP_NAME=OutfitAR
APP_VERSION=1.0.0
APP_ENV=development            # development | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32chars

#   Server 
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database MySQL (Laragon) DB_HOST=localhost
DB_PORT=3306
DB_NAME=outfit_ar
DB_USER=root
DB_PASSWORD=                  
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT Authentication ---
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# --- Redis Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Upload & Storage ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# --- Model ML ---
MODEL_DIR=./data/models/weights
EFFICIENTNET_WEIGHTS=efficientnet_skin_tone.h5
UNET_WEIGHTS=unet_tryon.h5
KNN_MODEL_PATH=./data/models/knn_recommender.pkl
FEATURE_CACHE_PATH=./data/models/feature_cache.pkl

UPLOAD_DIR=./data/uploads


# --- AR Configuration ---
AR_WEBSOCKET_PORT=8001
AR_FRAME_RATE=30
AR_RESOLUTION_WIDTH=640
AR_RESOLUTION_HEIGHT=480

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/outfit_ar.log

# --- External API (opsional) ---
SHOPEE_API_KEY=
ZALORA_BASE_URL=https://www.zalora.co.id
